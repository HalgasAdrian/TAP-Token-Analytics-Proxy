# ---- Never commit a real .env. This file is a template only. ----
DATABASE_URL=postgresql+asyncpg://tap:tap@postgres:5432/tap
REDIS_URL=redis://redis:6379/0
# Point this at the bundled fake provider to run the whole pipeline with no
# API key and no provider spend: http://mock-upstream:9000
# (requires `docker compose --profile dev up` — see SETUP.md section 5)
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_TIMEOUT_SECONDS=60.0
AUTH_ENABLED=false
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=false
DEFAULT_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
LOGGING_ENABLED=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# ---- Postgres container ----
POSTGRES_USER=tap
POSTGRES_PASSWORD=tap
POSTGRES_DB=tap
