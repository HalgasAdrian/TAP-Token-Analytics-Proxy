# Template for TAP's environment. Copy to .env and edit.
# Never commit a real .env — only this file is tracked.

# ---- Infrastructure ----
# Hostnames are Compose service names; change them if running outside Compose.
DATABASE_URL=postgresql+asyncpg://tap:tap@postgres:5432/tap
REDIS_URL=redis://redis:6379/0

# ---- Upstream provider ----
# Any OpenAI-compatible base URL. Set this to http://mock-upstream:9000 to run
# against the bundled fake provider — no API key, no provider spend.
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_TIMEOUT_SECONDS=60.0

# ---- Authentication ----
# When true, callers must send a TAP-issued API key in the X-TAP-Key header.
# Issue one with `python -m app.cli issue-key`. The caller's provider key stays
# in Authorization and is forwarded upstream untouched.
AUTH_ENABLED=false

# ---- Cache ----
# How long a cached response stays valid.
CACHE_TTL_SECONDS=3600

# ---- Rate limiting ----
# Requests allowed per window. DEFAULT_RATE_LIMIT applies to new keys and to
# unauthenticated traffic; each key can override it.
DEFAULT_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Table growth ----
# Bodies take up most of the space in request_logs. A body whose JSON is bigger
# than this is replaced with a size marker; 0 keeps bodies whole.
MAX_BODY_BYTES=16384
# Age at which `python -m app.cli prune-logs` deletes rows; 0 keeps everything.
LOG_RETENTION_DAYS=30

# ---- Web ----
# Comma-separated origins allowed to call the metrics API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Postgres container ----
# Consumed by the postgres service; keep in sync with DATABASE_URL.
POSTGRES_USER=tap
POSTGRES_PASSWORD=tap
POSTGRES_DB=tap
